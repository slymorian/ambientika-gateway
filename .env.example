# ---------- Serial ----------

AMBIENTIKA_PANEL_PORT=/dev/ambientika-panel
AMBIENTIKA_FANS_PORT=/dev/ambientika-fans
AMBIENTIKA_BAUDRATE=9600

# Alternative: RS485-zu-Ethernet-Konverter statt USB-Dongles.
# Siehe README, Abschnitt "Serielle Anbindung: USB-RS485-Dongle oder
# RS485-zu-Ethernet-Konverter".
# AMBIENTIKA_PANEL_PORT=socket://192.0.2.138:4196
# AMBIENTIKA_FANS_PORT=socket://192.0.2.137:4196

# Fortgeschrittene Serial-Einstellungen (Defaults funktionieren normalerweise):
# AMBIENTIKA_SERIAL_TIMEOUT=0.02
# AMBIENTIKA_SERIAL_WRITE_TIMEOUT=1.0
# AMBIENTIKA_SERIAL_READ_SIZE=256

# ---------- MQTT ----------

AMBIENTIKA_MQTT_HOST=192.0.2.204
AMBIENTIKA_MQTT_PORT=1883
AMBIENTIKA_MQTT_USER=your-mqtt-username
AMBIENTIKA_MQTT_PASSWORD=

AMBIENTIKA_MQTT_BASE_TOPIC=ambientika
AMBIENTIKA_MQTT_CLIENT_ID=ambientika-gateway

# Fortgeschrittene MQTT-Einstellungen (Defaults funktionieren normalerweise):
# AMBIENTIKA_MQTT_KEEPALIVE=60
# AMBIENTIKA_MQTT_RETAIN_STATE=true

# ---------- Gateway ----------

AMBIENTIKA_CONTROL_SEND_INTERVAL=0.5
AMBIENTIKA_PANEL_TIMEOUT=3.0
AMBIENTIKA_FAN_REPLY_TIMEOUT=15.0
AMBIENTIKA_LOG_LEVEL=INFO
