# ---------- Serial ----------

AMBIENTIKA_PANEL_PORT=/dev/ambientika-panel
AMBIENTIKA_FANS_PORT=/dev/ambientika-fans
AMBIENTIKA_BAUDRATE=9600

# ---------- MQTT ----------

AMBIENTIKA_MQTT_HOST=192.0.2.204
AMBIENTIKA_MQTT_PORT=1883
AMBIENTIKA_MQTT_USER=mqtt
AMBIENTIKA_MQTT_PASSWORD=

AMBIENTIKA_MQTT_BASE_TOPIC=ambientika
AMBIENTIKA_MQTT_CLIENT_ID=ambientika-gateway

# ---------- Gateway ----------

AMBIENTIKA_CONTROL_SEND_INTERVAL=0.5
AMBIENTIKA_PANEL_TIMEOUT=3.0
AMBIENTIKA_FAN_REPLY_TIMEOUT=15.0
AMBIENTIKA_LOG_LEVEL=INFO
